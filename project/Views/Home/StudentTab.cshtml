@model IEnumerable<project.Models.Student>

@{
    ViewData["Title"] = "Student Tab";
}
<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Math Score</th>
            <th>English Score</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.MathScore</td>
                <td>@student.EnglishScore</td>
            </tr>
        }
    </tbody>
</table>